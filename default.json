{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":pinAllExceptPeerDependencies"
  ],
  "packageRules": [
    {
      "description": "Auto-merge test or lint packages",
      "matchPackageNames": [
        "vitest",
        "@biomejs/biome"
      ],
      "automerge": true
    },
    {
      "description": "Exclude TypeScript 7.0. See https://github.com/vercel/ncc/issues/1336",
      "matchDepNames": [
        "typescript"
      ],
      "matchDatasources": [
        "npm"
      ],
      "allowedVersions": "!/^7\\.0\\./"
    },
    {
      "description": "Update node version of this action",
      "matchDepNames": [
        "node",
        "@types/node"
      ],
      "groupName": "node",
      "groupSlug": "node",
      "allowedVersions": "<=24"
    },
    {
      "description": "Replace @tsconfig/node and group it into node major updates",
      "matchDepNames": [
        "@tsconfig/node20"
      ],
      "replacementName": "@tsconfig/node24",
      "replacementVersion": "24.0.3",
      "minimumReleaseAge": null,
      "replacement": {
        "branchTopic": "major-node",
        "commitMessageAction": "Update node to v24"
      }
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update node version of using field in action.yaml",
      "managerFilePatterns": [
        "**/action.yaml",
        "**/action.yml"
      ],
      "matchStrings": [
        "using: 'node(?<currentValue>\\d+)'"
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version"
    },
    {
      "customType": "regex",
      "description": "Update @tsconfig/node version in tsconfig.json",
      "managerFilePatterns": [
        "**/tsconfig.json"
      ],
      "matchStrings": [
        "@tsconfig/node(?<currentValue>\\d+)/"
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version"
    },
    {
      "customType": "regex",
      "description": "Update this config by self",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "int128/typescript-action-renovate-config",
      "managerFilePatterns": [
        "renovate.json",
        "renovate.json5",
        ".github/renovate.json",
        ".github/renovate.json5"
      ],
      "matchStrings": [
        "\"github>int128/typescript-action-renovate-config#(?<currentValue>.+?)\"",
        "\"github>int128/typescript-action-renovate-config:.+?#(?<currentValue>.+?)\""
      ]
    }
  ]
}